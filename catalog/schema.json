{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gyro Pro turntable catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "models"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^\\s/]+(?:/[^\\s]*)?$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "key",
        "url",
        "title"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "drive_type": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "enum": [
                "belt",
                "direct",
                "idler"
              ]
            },
            "source": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "required": [
            "value",
            "source"
          ]
        },
        "speeds_rpm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[1-9][0-9]*(?:/[1-9][0-9]*)?$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "source": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            }
          },
          "required": [
            "value",
            "source"
          ]
        },
        "specifications": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "original": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "standard": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "weighting": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "condition": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "name",
              "original",
              "value",
              "unit",
              "source"
            ]
          },
          "minItems": 1
        },
        "related_designations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "designation": {
                "type": "string",
                "pattern": "\\S"
              },
              "type": {
                "enum": [
                  "color_variant"
                ]
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "color": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "designation",
              "type",
              "source"
            ]
          }
        }
      },
      "required": [
        "model_id",
        "manufacturer",
        "model",
        "aliases",
        "sources"
      ]
    }
  }
}
